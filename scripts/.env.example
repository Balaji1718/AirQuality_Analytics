# Environment Variables for Air Quality Data Collection

# Required: Neon PostgreSQL Database Connection
NEON_DATABASE_URL=postgresql://username:password@host:5432/database

# Optional: API Keys for better data quality (fallback data available without these)
WAQI_TOKEN=your_waqi_api_token_here
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Note: If API keys are not provided, the script will generate realistic fallback data
# The database URL is required for all operations